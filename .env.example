# Zenhance runs in four stages: lab -> next -> release -> main.
# Only `main` is public. See docs/ENVIRONMENTS.md.
#
# This file is for the fifth: your own machine. Copy it to .env.local.

# --- Database -------------------------------------------------------------
# Keep this pointed at Postgres on YOUR MACHINE.
#
# Every seeder (db:seed, db:companies, db:scale, db:northwind) refuses to run
# against anything else — they write invented people, and pointed at a hosted
# database that overwrites real ones with no undo. The guard is
# `requireLocalDatabase` in lib/env.ts.
#
# Hosted connection strings belong in Vercel's environment variables, one per
# stage, never here.
DATABASE_URL="postgresql://localhost:5432/zenhance"

# --- Auth (Clerk) ---------------------------------------------------------
# Create a free app at https://dashboard.clerk.com and paste the keys.
# Leave these blank in local dev to use the fenced dev-auth bypass (see DEV_AUTH).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Stage (set by Vercel, not by you) ------------------------------------
# VERCEL_ENV and VERCEL_GIT_COMMIT_REF tell the app which stage it is running
# in (lib/env.ts). Locally both are absent, which means stage "local":
# lab pages visible, nothing indexed by search engines.
# Set VERCEL_ENV=production locally only to check the production gating.

# --- Dev auth bypass ------------------------------------------------------
# When set to "1" AND NODE_ENV is not production AND Clerk keys are absent,
# the app injects a fixed dev user so you can run without a Clerk account.
# NEVER enable in production.
DEV_AUTH="1"
