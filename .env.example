# --- Database -------------------------------------------------------------
# Local dev: a local Postgres database (postgres.js driver).
# Production: paste your Neon pooled connection string here (same driver).
DATABASE_URL="postgresql://localhost:5432/zenhance"

# --- Auth (Clerk) ---------------------------------------------------------
# Create a free app at https://dashboard.clerk.com and paste the keys.
# Leave these blank in local dev to use the fenced dev-auth bypass (see DEV_AUTH).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Dev auth bypass ------------------------------------------------------
# When set to "1" AND NODE_ENV is not production AND Clerk keys are absent,
# the app injects a fixed dev user so you can run without a Clerk account.
# NEVER enable in production.
DEV_AUTH="1"
